rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // Collection: /profiles/{deviceId}
    // Stores all real player profiles directly in Firestore
    match /profiles/{deviceId} {
      allow get, list: if true;
      allow create, update: if isValidId(deviceId) &&
        incoming().deviceId is string &&
        incoming().deviceId == deviceId &&
        incoming().name is string &&
        incoming().name.size() >= 1 &&
        incoming().name.size() <= 64 &&
        incoming().cytes is number &&
        incoming().cytes >= 0;
      allow delete: if isValidId(deviceId);
    }

    // Collection: /devs/{devId}
    // Stores 'primary_dev' (the first person to enter the website) and individual DEV badge configs
    match /devs/{devId} {
      allow get, list: if true;
      allow create: if isValidId(devId) &&
        incoming().deviceId is string &&
        incoming().deviceId.size() >= 1 &&
        incoming().deviceId.size() <= 128;
      allow update: if isValidId(devId) &&
        incoming().deviceId is string &&
        incoming().deviceId.size() >= 1 &&
        incoming().deviceId.size() <= 128 &&
        (devId != 'primary_dev' || incoming().firstDevId == resource.data.firstDevId || !('firstDevId' in resource.data));
      allow delete: if isValidId(devId) && devId != 'primary_dev';
    }

    // Collection: /reports/{reportId}
    match /reports/{reportId} {
      allow get, list: if true;
      allow create, update: if isValidId(reportId) &&
        incoming().id is string &&
        incoming().details is string &&
        incoming().details.size() >= 1 &&
        incoming().details.size() <= 2000;
      allow delete: if isValidId(reportId);
    }

    // Collection: /daily_leaderboard/{dayKey}
    match /daily_leaderboard/{dayKey} {
      allow get, list: if true;
      allow create, update: if isValidId(dayKey);
    }

    // Collection: /moderation/{deviceId}
    match /moderation/{deviceId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(deviceId);
    }

    // Collection: /territories/{organId}
    match /territories/{organId} {
      allow get, list: if true;
      allow create, update: if isValidId(organId);
    }

    // Collection: /test/{docId}
    match /test/{docId} {
      allow get: if true;
    }
  }
}
