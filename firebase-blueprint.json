{
  "entities": {
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Stores a player's persistent profile, device ID, Cytes balance, upgrades, stats, and DEV status in Firestore.",
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "description": "Unique hardware/browser device identifier",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Player display name",
          "minLength": 1,
          "maxLength": 64
        },
        "deviceType": {
          "type": "string",
          "description": "Device category (Móvil, Tablet, Desktop)",
          "maxLength": 32
        },
        "cytes": {
          "type": "number",
          "description": "Current Cytes balance"
        },
        "totalCytesEarned": {
          "type": "number",
          "description": "Cumulative Cytes earned"
        },
        "selectedSkinId": {
          "type": "string",
          "maxLength": 64
        },
        "selectedSporeId": {
          "type": "string",
          "maxLength": 64
        },
        "selectedBacteriaId": {
          "type": "string",
          "maxLength": 64
        },
        "preferredLanguage": {
          "type": "string",
          "maxLength": 16
        },
        "isDev": {
          "type": "boolean"
        },
        "isFirstDev": {
          "type": "boolean"
        },
        "isRealUser": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": ["deviceId", "name", "cytes", "totalCytesEarned", "selectedSkinId", "selectedSporeId", "selectedBacteriaId", "preferredLanguage"]
    },
    "DevRecord": {
      "title": "DevRecord",
      "description": "Stores primary developer registration (primary_dev) and customizable DEV badge settings in Firestore.",
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "firstDevId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "isPrimaryDev": {
          "type": "boolean"
        },
        "isDev": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "color": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16
        },
        "iconPreset1": {
          "type": "string",
          "maxLength": 32
        },
        "iconPreset2": {
          "type": "string",
          "maxLength": 32
        },
        "updatedAt": {
          "type": "number"
        }
      },
      "required": ["deviceId", "title", "color", "iconPreset1", "iconPreset2"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "Stores bug, cheat, and behavior reports submitted by players in Firestore.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reporterDeviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "enum": ["cheat", "bug", "behavior", "desync", "other"],
          "maxLength": 32
        },
        "reportedUser": {
          "type": "string",
          "maxLength": 64
        },
        "when": {
          "type": "string",
          "maxLength": 128
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": ["pending", "investigating", "resolved", "dismissed"],
          "maxLength": 32
        },
        "devNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "timestamp": {
          "type": "number"
        }
      },
      "required": ["id", "reporterDeviceId", "category", "details", "severity", "status"]
    }
  },
  "firestore": {
    "/profiles/{deviceId}": {
      "schema": "PlayerProfile",
      "description": "Player profiles keyed by device ID."
    },
    "/devs/{devId}": {
      "schema": "DevRecord",
      "description": "Primary DEV record (primary_dev) and developer badge records keyed by device ID."
    },
    "/reports/{reportId}": {
      "schema": "UserReport",
      "description": "Player bug and behavior reports."
    }
  }
}
